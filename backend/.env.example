# --- App ---
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# --- Banco ---
DATABASE_URL=postgresql://folks:folks@localhost:5433/universo_folks?schema=public

# --- Auth ---
JWT_ACCESS_SECRET=troque-este-segredo-access
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=troque-este-segredo-refresh
JWT_REFRESH_TTL_DAYS=30

# --- Seed (primeiro MASTER-FOLKS) ---
SEED_MASTER_EMAIL=master@folks.com.br
SEED_MASTER_PASSWORD=TroqueEssaSenha123

# --- Vimeo ---
# token "Authenticated" (developer.vimeo.com > seu app) com escopos: public private edit
VIMEO_ACCESS_TOKEN=
# domínios onde o player pode tocar (embed restrito), separados por vírgula
VIMEO_EMBED_DOMAINS=app.folkspoplearning.com.br,localhost

# --- Storage (pacotes SCORM/xAPI, PDFs de certificados) ---
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage

# --- App (links dos e-mails de convite e nova senha: /convite?token= e /nova-senha?token=) ---
PUBLIC_APP_URL=http://localhost:5173

# --- E-mail transacional (Resend). Vazio = e-mails só aparecem no log ---
RESEND_API_KEY=
EMAIL_FROM=Folks Poplearning <nao-responda@folkspoplearning.com.br>

# --- Premium nas lojas (RevenueCat): header Authorization configurado no webhook ---
REVENUECAT_WEBHOOK_AUTH=troque-este-segredo
# aceitar eventos SANDBOX em produção (testes de loja)
REVENUECAT_ACCEPT_SANDBOX=false

# --- Asaas (Premium na web + contratos de empresas) ---
# chave em Integrações > Chave de API. Vazio = checkout web desligado.
ASAAS_API_KEY=
# sandbox: https://api-sandbox.asaas.com/v3 | produção: https://api.asaas.com/v3
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
# token configurado no webhook do painel Asaas (chega no header asaas-access-token)
ASAAS_WEBHOOK_TOKEN=troque-este-token
